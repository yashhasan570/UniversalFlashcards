[Desktop Entry]
Name=Universal Flashcards
Comment=An intelligent spaced-repetition memory training program
GenericName=Flashcards
Exec=universalflashcards %f
TryExec=universalflashcards
Icon=universalflashcards
Categories=Education;Languages;KDE;Qt;
Terminal=false
Type=Application
Version=1.0
MimeType=application/x-colpkg;application/x-apkg;application/x-universalflashcards;application/x-universalflashcardsaddon;application/vnd.universalflashcards;
#should be removed eventually as it was upstreamed as to be an XDG specification called SingleMainWindow
X-GNOME-SingleWindow=true
SingleMainWindow=true
StartupWMClass=universalflashcards
