[submodule "ftl/core-repo"]
	path = ftl/core-repo
	url = https://github.com/yashhasan570/UniversalFlashcards-core-i18n.git
	shallow = true
[submodule "ftl/qt-repo"]
	path = ftl/qt-repo
	url = https://github.com/yashhasan570/UniversalFlashcards-desktop-ftl.git
	shallow = true
[submodule "briefcase-mac-template"]
	path = qt/installer/mac-template
	url = https://github.com/yashhasan570/briefcase-macOS-app-template
	branch = universalflashcards
	shallow = true
[submodule "briefcase-windows-template"]
	path = qt/installer/windows-template
	url = https://github.com/yashhasan570/briefcase-windows-VisualStudio-template
	branch = universalflashcards
	shallow = true
